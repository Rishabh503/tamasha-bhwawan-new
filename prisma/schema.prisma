// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

enum QuestionType {
  MCQ
  SUBJECTIVE
}
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LiveQuizStatus {
  LOBBY
  IN_PROGRESS
  COMPLETED
}

enum LiveParticipantStatus {
  WAITING
  ACCEPTED
  REJECTED
}

/* =======================
   USER
======================= */

model User {
  id                   String   @id @default(cuid())
  clerkUserId          String   @unique
  email                String   @unique
  name                 String?
  phone                String?
  onboardingCompleted  Boolean  @default(false)
  role                 Role     @default(USER)

  enrollments          Enrollment[]
  testAttempts         TestAttempt[]
  paymentRequests      PaymentRequest[]
  
  createdLiveQuizzes   LiveQuiz[]
  liveQuizParticipations LiveQuizParticipant[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/* =======================
   COURSE
======================= */

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  isPublished  Boolean  @default(false)
 imageUrl     String? 
 price        Decimal  @default(0)
upiId        String?  
  upiQrCode    String?  
paymentRequests PaymentRequest[]
  chapters     Chapter[]
  enrollments  Enrollment[]
  tests        Test[]
  qrCodeId     String?
  qrCode       QRCode?  @relation(fields: [qrCodeId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum QRCodeStatus {
  ACTIVE
  INACTIVE
}

model QRCode {
  id          String        @id @default(cuid())
  name        String
  upiId       String
  qrImageUrl  String
  status      QRCodeStatus  @default(ACTIVE)
  courses     Course[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([status])
}
/* =======================
   CHAPTER
======================= */

model Chapter {
  id        String   @id @default(cuid())
  title     String
  order     Int

  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  videos    Video[]

  createdAt DateTime @default(now())
}

model PaymentRequest {
  id                String        @id @default(cuid())
  
  userId            String
  courseId          String
  
  // Payment Details
  amount            Decimal
  transactionId     String?       // UTR/Transaction ID provided by student
  paymentScreenshot String        // Cloudinary URL of payment screenshot
  
  // Student Info (can update if missing)
  studentName       String
  studentEmail      String
  studentPhone      String
  
  // Status
  status            PaymentStatus @default(PENDING)
  
  // Admin Review
  reviewedBy        String?       // Admin user ID who reviewed
  reviewedAt        DateTime?
  rejectionReason   String?       // Reason if rejected
  
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([userId, courseId, status])
}

/* =======================
   VIDEO
======================= */

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeUrl  String

order         Int
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  notes       Note[]
  pyqs        PYQ[]

  createdAt   DateTime @default(now())
}

/* =======================
   NOTES
======================= */

model Note {
  id        String   @id @default(cuid())
  content   String?
  pdfUrl    String?

  videoId  String
  video    Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/* =======================
   PYQ (MCQ + Solution)
======================= */

model PYQ {
  id           String   @id @default(cuid())
  question     String
  options      String[]   // ["A", "B", "C", "D"]
  correctIndex Int
  solution     String?

  videoId      String
  video        Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

/* =======================
   ENROLLMENT (NO PAYMENT)
======================= */

model Enrollment {
  id        String   @id @default(cuid())

  userId    String
  courseId  String

  status    EnrollmentStatus @default(ACTIVE)

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // one user can buy once
}

/* =======================
   MOCK TEST
======================= */

model Test {
  id        String   @id @default(cuid())
  title     String
  courseId  String?

  course        Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions     TestQuestion[]
  testAttempts  TestAttempt[]   

  createdAt DateTime @default(now())
}

/* =======================
   TEST QUESTIONS
======================= */

model TestQuestion {
  id          String       @id @default(cuid())
  question    String
  type        QuestionType

  options     String[]
  correctAns  String?

  testId      String
  test        Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

/* =======================
   TEST ATTEMPTS
======================= */

model TestAttempt {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  score     Int?

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  

  createdAt DateTime @default(now())
}

/* =======================
   LIVE QUIZ
======================= */

model LiveQuiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      LiveQuizStatus @default(LOBBY)
  joinCode    String?  @unique

  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id])
  
  questions   LiveQuizQuestion[]
  participants LiveQuizParticipant[]
  sessions    LiveQuizSession[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveQuizSession {
  id          String   @id @default(cuid())
  quizId      String
  quiz        LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  pin         String
  status      LiveQuizStatus @default(LOBBY)

  participants LiveQuizParticipant[]

  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quizId])
}

model LiveQuizQuestion {
  id              String   @id @default(cuid())
  quizId          String
  quiz            LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  questionText    String?
  imageUrl        String?
  type            QuestionType  // MCQ or SUBJECTIVE
  options         String[]      // For MCQ
  correctAns      String?       // Exact answer or option
  timeLimitSeconds Int          @default(30)
  
  order           Int           @default(0)

  responses       LiveQuizResponse[]
}

model LiveQuizParticipant {
  id        String   @id @default(cuid())
  quizId    String
  quiz      LiveQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  sessionId String?
  session   LiveQuizSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  
  status    LiveParticipantStatus @default(WAITING)
  score     Int      @default(0)

  responses LiveQuizResponse[]

  createdAt DateTime @default(now())
  
  @@index([quizId])
  @@index([sessionId])
}

model LiveQuizResponse {
  id             String   @id @default(cuid())
  participantId  String
  participant    LiveQuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  
  questionId     String
  question       LiveQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  answer         String
  isCorrect      Boolean  @default(false)
  timeTaken      Int?

  createdAt      DateTime @default(now())
  
  @@unique([participantId, questionId])
}